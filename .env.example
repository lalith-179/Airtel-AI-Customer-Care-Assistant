# Copy this file to .env and adjust as needed.

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=gemma3:1b
VISION_MODEL=qwen2.5vl:3b
EMBEDDING_MODEL=nomic-embed-text:latest

# ChromaDB (already-built knowledge base)
CHROMA_PATH=knowledge_base/chroma
COLLECTION_NAME=airtel_support

# Retrieval
TOP_K=5
SIMILARITY_THRESHOLD=0.70

# Chunking (used only by scripts/build_knowledge_base.py)
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# STT
STT_MODEL=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

# TTS
TTS_ENGINE=piper
PIPER_VOICE_EN=en_US-lessac-medium
PIPER_VOICE_TE=te_IN-medium

# Flask
FLASK_SECRET_KEY=change-me-in-production
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# Audio storage
PERSIST_RAW_AUDIO=false
AUDIO_TMP_DIR=tmp_audio
